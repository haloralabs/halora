{
  "name": "@halora/shared",
  "version": "0.1.0",
  "description": "Shared types, zod schemas, constants and contract IDs for Halora",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts.testnet.json": "./src/contracts.testnet.json",
    "./contracts.mainnet.json": "./src/contracts.mainnet.json",
    "./policy": {
      "types": "./src/policy.ts",
      "default": "./src/policy.ts"
    },
    "./amount": {
      "types": "./src/amount.ts",
      "default": "./src/amount.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0"
  }
}
