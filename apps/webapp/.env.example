# Data source for the dashboard.
#   mock: seeded, in-memory demo data. No wallet extension, API or network needed. (default)
#   live: Halora API (apps/api) plus Soroban RPC through @halora/sdk, owner wallet via Stellar Wallets Kit.
NEXT_PUBLIC_HALORA_DATA_MODE=mock

# Used in live mode only.
NEXT_PUBLIC_HALORA_NETWORK=testnet
NEXT_PUBLIC_HALORA_API_URL=http://localhost:3001
NEXT_PUBLIC_HALORA_RPC_URL=https://soroban-testnet.stellar.org
