# Copy to .env and adjust. Never commit a real .env.
DATABASE_URL=postgres://halora:halora@localhost:5432/halora
PORT=3001
LOG_LEVEL=info
HALORA_NETWORK=testnet
# Defaults to https://soroban-testnet.stellar.org on testnet. Required on mainnet.
# STELLAR_RPC_URL=
AUTH_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_SECONDS=3600
CHALLENGE_TTL_SECONDS=300
APPROVAL_DEFAULT_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=120
# Only set to true behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=5000
EXPIRY_INTERVAL_MS=15000
