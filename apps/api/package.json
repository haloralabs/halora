{
  "name": "@halora/api",
  "version": "0.1.0",
  "description": "Halora API: approval queue and payment log for policy-bound agent wallets on Stellar",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@halora/shared": "workspace:*",
    "@stellar/stellar-sdk": "^17.2.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  }
}
