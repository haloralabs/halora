{
  "name": "@halora/mcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents a policy-bound Halora wallet on Stellar",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "halora-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@halora/sdk": "workspace:*",
    "@halora/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  }
}
